# ==========================================================
# FeedNeed Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit your actual .env file to version control!
# ==========================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/feedneed

# JWT Secret Key (Use a long random string in production)
JWT_SECRET=replace_this_with_a_long_random_jwt_secret_string_at_least_32_chars

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=https://feedneed.vercel.app
